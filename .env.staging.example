# ==========================================================
# STAGING ENVIRONMENT CONFIGURATION (API)
# ==========================================================
# PENTING: Gunakan database staging terpisah (stokbarang_db_staging).
# JANGAN pernah mengarahkan DATABASE_URL staging ke database produksi!

# Contoh jika menggunakan user root dan hostname docker 'mysql-db':
DATABASE_URL="mysql://root:GANTI_DENGAN_PASSWORD_ROOT_DB@mysql-db:3306/stokbarang_db_staging"

# Atau jika menggunakan IP server:
# DATABASE_URL="mysql://root:GANTI_DENGAN_PASSWORD_ROOT_DB@72.60.76.151:3306/stokbarang_db_staging"

# Port internal aplikasi
PORT=3000

# Secret JWT khusus untuk Staging
JWT_SECRET=super_secret_staging_jwt_key_987654321

# Origin yang diizinkan untuk CORS (staging frontend di port 8080)
FRONTEND_URL="http://localhost:8080,http://localhost:5173,*"

# Node environment
NODE_ENV=staging
